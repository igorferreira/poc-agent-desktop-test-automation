>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. CADCLI.

ENVIRONMENT DIVISION.
CONFIGURATION SECTION.
SPECIAL-NAMES.
    CRT STATUS IS WS-KEY.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT ARQ ASSIGN TO "data/clientes.dat"
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-FS.

DATA DIVISION.
FILE SECTION.
FD ARQ.
01 REG-ARQ PIC X(69).

WORKING-STORAGE SECTION.
01 WS-FS     PIC XX.
01 WS-KEY    PIC 9(4) VALUE 0.
01 WS-MSG    PIC X(60) VALUE SPACES.
01 WS-OPCAO  PIC X VALUE SPACE.
01 WS-N      PIC 999 VALUE 0.
01 WS-I      PIC 999.
01 WS-ACHOU  PIC 999.
01 WS-EOF    PIC X VALUE "N".
01 WS-FIM    PIC X VALUE "N".
01 WS-VOLTA  PIC X VALUE "N".
01 WS-UFOK   PIC 99.
01 WS-UFS    PIC X(54) VALUE
   "ACALAPAMBACEDFESGOMAMTMSMGPAPBPRPEPIRJRNRSRORRSCSPSETO".
01 WS-UFTAB REDEFINES WS-UFS.
   05 WS-UFE PIC XX OCCURS 27.
01 TAB.
   05 T-REG OCCURS 100.
      10 T-COD    PIC X(6).
      10 T-NOME   PIC X(30).
      10 T-CPF    PIC X(11).
      10 T-CIDADE PIC X(20).
      10 T-UF     PIC X(2).
01 WS-REG.
   05 R-COD    PIC 9(6) VALUE ZEROS.
   05 R-NOME   PIC X(30) VALUE SPACES.
   05 R-CPF    PIC 9(11) VALUE ZEROS.
   05 R-CIDADE PIC X(20) VALUE SPACES.
   05 R-UF     PIC X(2) VALUE SPACES.
01 WS-CONS.
   05 C-COD    PIC 9(6) VALUE ZEROS.
   05 C-NOME   PIC X(30) VALUE SPACES.
   05 C-CPF    PIC X(11) VALUE SPACES.
   05 C-CIDADE PIC X(20) VALUE SPACES.
   05 C-UF     PIC X(2) VALUE SPACES.

SCREEN SECTION.
01 S-T01 FOREGROUND-COLOR 2 BACKGROUND-COLOR 0.
   05 BLANK SCREEN.
   05 LINE 1 COLUMN 2 VALUE "CADCLI".
   05 LINE 1 COLUMN 31 VALUE "CADASTRO DE CLIENTES".
   05 LINE 1 COLUMN 78 VALUE "T01".
   05 LINE 5 COLUMN 10 VALUE "1-INCLUIR".
   05 LINE 7 COLUMN 10 VALUE "2-CONSULTAR".
   05 LINE 9 COLUMN 10 VALUE "9-SAIR".
   05 LINE 12 COLUMN 10 VALUE "OPCAO .:".
   05 LINE 12 COLUMN 19 PIC X USING WS-OPCAO.
   05 LINE 23 COLUMN 2 VALUE "F3=SAIR  ENTER=CONFIRMAR".
   05 LINE 24 COLUMN 2 PIC X(60) FROM WS-MSG.

01 S-T02 FOREGROUND-COLOR 2 BACKGROUND-COLOR 0.
   05 BLANK SCREEN.
   05 LINE 1 COLUMN 2 VALUE "CADCLI".
   05 LINE 1 COLUMN 31 VALUE "INCLUSAO DE CLIENTE".
   05 LINE 1 COLUMN 78 VALUE "T02".
   05 LINE 4 COLUMN 4 VALUE "CODIGO .:".
   05 LINE 4 COLUMN 14 PIC 9(6) USING R-COD.
   05 LINE 5 COLUMN 4 VALUE "NOME ...:".
   05 LINE 5 COLUMN 14 PIC X(30) USING R-NOME.
   05 LINE 6 COLUMN 4 VALUE "CPF ....:".
   05 LINE 6 COLUMN 14 PIC 9(11) USING R-CPF.
   05 LINE 7 COLUMN 4 VALUE "CIDADE .:".
   05 LINE 7 COLUMN 14 PIC X(20) USING R-CIDADE.
   05 LINE 8 COLUMN 4 VALUE "UF .....:".
   05 LINE 8 COLUMN 14 PIC X(2) USING R-UF.
   05 LINE 23 COLUMN 2 VALUE "F3=VOLTAR  F12=CANCELAR  ENTER=CONFIRMAR".
   05 LINE 24 COLUMN 2 PIC X(60) FROM WS-MSG.

01 S-T03 FOREGROUND-COLOR 2 BACKGROUND-COLOR 0.
   05 BLANK SCREEN.
   05 LINE 1 COLUMN 2 VALUE "CADCLI".
   05 LINE 1 COLUMN 31 VALUE "CONSULTA DE CLIENTE".
   05 LINE 1 COLUMN 78 VALUE "T03".
   05 LINE 4 COLUMN 4 VALUE "CODIGO .:".
   05 LINE 4 COLUMN 14 PIC 9(6) USING C-COD.
   05 LINE 6 COLUMN 4 VALUE "NOME ...:".
   05 LINE 6 COLUMN 14 PIC X(30) FROM C-NOME.
   05 LINE 7 COLUMN 4 VALUE "CPF ....:".
   05 LINE 7 COLUMN 14 PIC X(11) FROM C-CPF.
   05 LINE 8 COLUMN 4 VALUE "CIDADE .:".
   05 LINE 8 COLUMN 14 PIC X(20) FROM C-CIDADE.
   05 LINE 9 COLUMN 4 VALUE "UF .....:".
   05 LINE 9 COLUMN 14 PIC X(2) FROM C-UF.
   05 LINE 23 COLUMN 2 VALUE "F3=VOLTAR  ENTER=CONSULTAR".
   05 LINE 24 COLUMN 2 PIC X(60) FROM WS-MSG.

PROCEDURE DIVISION.
    PERFORM CARREGA
    PERFORM UNTIL WS-FIM = "S"
        PERFORM TELA-MENU
    END-PERFORM
    STOP RUN.

CARREGA.
    OPEN INPUT ARQ
    IF WS-FS = "00"
        PERFORM UNTIL WS-EOF = "S" OR WS-N = 100
            READ ARQ
                AT END MOVE "S" TO WS-EOF
                NOT AT END
                    ADD 1 TO WS-N
                    MOVE REG-ARQ TO T-REG (WS-N)
            END-READ
        END-PERFORM
        CLOSE ARQ
    END-IF.

TELA-MENU.
    MOVE SPACE TO WS-OPCAO
    DISPLAY S-T01
    ACCEPT S-T01
    MOVE SPACES TO WS-MSG
    IF WS-KEY = 1003
        MOVE "S" TO WS-FIM
    ELSE
        EVALUATE WS-OPCAO
            WHEN "1" PERFORM INCLUI
            WHEN "2" PERFORM CONSULTA
            WHEN "9" MOVE "S" TO WS-FIM
            WHEN OTHER MOVE "OPCAO INVALIDA" TO WS-MSG
        END-EVALUATE
    END-IF.

INCLUI.
    MOVE "N" TO WS-VOLTA
    INITIALIZE WS-REG
    MOVE SPACES TO WS-MSG
    PERFORM UNTIL WS-VOLTA = "S"
        DISPLAY S-T02
        ACCEPT S-T02
        MOVE SPACES TO WS-MSG
        EVALUATE WS-KEY
            WHEN 1003 MOVE "S" TO WS-VOLTA
            WHEN 1012 INITIALIZE WS-REG
            WHEN OTHER PERFORM VALIDA-GRAVA
        END-EVALUATE
    END-PERFORM
    MOVE SPACES TO WS-MSG.

VALIDA-GRAVA.
    PERFORM BUSCA
    IF WS-ACHOU > 0
        MOVE "CODIGO JA CADASTRADO" TO WS-MSG
    ELSE
        MOVE 0 TO WS-UFOK
        PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 27
            IF WS-UFE (WS-I) = R-UF MOVE 1 TO WS-UFOK END-IF
        END-PERFORM
        IF WS-UFOK = 0
            MOVE "UF INVALIDA" TO WS-MSG
        ELSE
            IF WS-N >= 100
                MOVE "CADASTRO CHEIO" TO WS-MSG
            ELSE
                PERFORM GRAVA
            END-IF
        END-IF
    END-IF.

BUSCA.
    MOVE 0 TO WS-ACHOU
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-N
        IF T-COD (WS-I) = R-COD AND WS-ACHOU = 0
            MOVE WS-I TO WS-ACHOU
        END-IF
    END-PERFORM.

GRAVA.
    ADD 1 TO WS-N
    MOVE WS-REG TO T-REG (WS-N)
    OPEN EXTEND ARQ
    MOVE WS-REG TO REG-ARQ
    WRITE REG-ARQ
    CLOSE ARQ
    INITIALIZE WS-REG
    MOVE "CLIENTE INCLUIDO" TO WS-MSG.

CONSULTA.
    MOVE "N" TO WS-VOLTA
    MOVE ZEROS TO C-COD
    MOVE SPACES TO C-NOME C-CPF C-CIDADE C-UF WS-MSG
    PERFORM UNTIL WS-VOLTA = "S"
        DISPLAY S-T03
        ACCEPT S-T03
        MOVE SPACES TO C-NOME C-CPF C-CIDADE C-UF WS-MSG
        IF WS-KEY = 1003
            MOVE "S" TO WS-VOLTA
        ELSE
            MOVE C-COD TO R-COD
            PERFORM BUSCA
            IF WS-ACHOU = 0
                MOVE "CLIENTE NAO ENCONTRADO" TO WS-MSG
            ELSE
                MOVE T-NOME (WS-ACHOU) TO C-NOME
                MOVE T-CPF (WS-ACHOU) TO C-CPF
                MOVE T-CIDADE (WS-ACHOU) TO C-CIDADE
                MOVE T-UF (WS-ACHOU) TO C-UF
            END-IF
        END-IF
    END-PERFORM
    MOVE SPACES TO WS-MSG.
